#!/usr/bin/env bash

set -euxo pipefail

die() {
  echo "$1"
  exit 1
}

new=/var/lib/lord/index.new
current=/var/lib/lord/index
old=/var/lib/lord/index.old

[[ -d $new ]] || die "new index missing: $new"
[[ ! -d $old ]] || die "backup index already exists: $old"

systemctl stop lord

chown -R lord:lord "$new"

[[ -d $current ]] && mv "$current" "$old"

mv "$new" "$current"

systemctl restart lord