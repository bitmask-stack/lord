#!/usr/bin/env bash

set -euxo pipefail

die() {
  echo "$1"
  exit 1
}

new=/var/lib/lord/index.redb.new
current=/var/lib/lord/index.redb
old=/var/lib/lord/index.redb.old

[[ -f $new ]] || die "new index missing: $new"
[[ ! -f $old ]] || die "backup index already exists: $old"

systemctl stop lord

chown lord:lord $new

[[ -f $current ]] && mv $current $old

mv $new $current

systemctl restart lord