#!/usr/bin/env bash

set -euo pipefail

if ! which rg > /dev/null; then
  echo "error: ripgrep (rg) not found"
  exit 1
fi

! rg \
  --glob '!bin/forbid' \
  --glob '!docs/src/bounty/frequency.tsv' \
  --glob '!docs/po/*' \
  --glob '!docs/src/lord/design.md' \
  --ignore-case \
  'dbg!|fixme|todo|xxx' \
  .

! rg \
  --glob '*.rs' \
  --glob '!target/**' \
  'redb::|use redb' \
  src/ \
  crates/

! rg \
  --glob 'Cargo.toml' \
  --glob '!target/**' \
  '^redb\s*=' \
  Cargo.toml \
  crates/